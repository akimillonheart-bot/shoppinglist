      { "ingredientId": "ing_豚ひき肉", "amount": 200, "unit": "g" },
      { "ingredientId": "ing_しょうゆ", "amount": 15, "unit": "ml" },
      { "ingredientId": "ing_おろしにんにく", "amount": 5, "unit": "g" },
      { "ingredientId": "ing_みりん", "amount": 10, "unit": "ml" },
      { "ingredientId": "ing_片栗粉", "amount": 15, "unit": "g" },
      { "ingredientId": "ing_ごま油", "amount": 5, "unit": "ml" },
