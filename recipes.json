[
  {
    "id": "nikusoboro_harusame_umami_mushi",
    "title": "肉そぼろと春雨のうまみ蒸し",
    "servings": 2,
    "assignedDay": "",
    "ingredients": [
      { "name": "春雨(乾燥)", "amount": "16～20g", "janCode": "" },
      { "name": "にんじん", "amount": "0.5本", "janCode": "" },
      { "name": "ニラ", "amount": "0.5束", "janCode": "" },
      { "name": "もやし", "amount": "1袋", "janCode": "" },
      { "name": "豚ひき肉", "amount": "150g", "janCode": "" },
      { "name": "しょうゆ", "amount": "大さじ2", "janCode": "" },
      { "name": "オイスターソース", "amount": "大さじ1", "janCode": "" },
      { "name": "酒", "amount": "大さじ1", "janCode": "" },
      { "name": "砂糖", "amount": "小さじ1", "janCode": "" },
      { "name": "おろしにんにく", "amount": "小さじ1", "janCode": "" },
      { "name": "片栗粉", "amount": "小さじ1", "janCode": "" },
      { "name": "しょうゆ（仕上げ用）", "amount": "適宜", "janCode": "" }
    ],
    "instructions": [
      "春雨は水につけてもどす。にんじんはせん切りにし、ニラは食べやすい長さに切る。",
      "せいろにクッキングシートを敷き、水けをきった春雨、にんじん、もやし、ひき肉を順に重ね入れる。混ぜ合わせたソース(A)を回しかける。",
      "中火で12分蒸す。軽く混ぜてニラをのせ、さらに3分蒸す。",
      "お好みでしょうゆをかける。"
    ]
  },
  {
