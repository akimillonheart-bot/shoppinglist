        "amount": 5,
        "unit": "g"
      },
      {
        "ingredientId": "ing_片栗粉",
        "amount": 5,
        "unit": "g"
      }
    ],
    "steps": [
      {
        "stepNo": 1,
        "text": "春雨は水につけてもどす。にんじんはせん切りにし、ニラは食べやすい長さに切る。"
      },
      {
        "stepNo": 2,
        "text": "せいろにクッキングシートを敷き、水けをきった春雨、にんじん、もやし、ひき肉を順に重ね入れる。混ぜ合わせたソース(A)を回しかける。"
      },
      {
        "stepNo": 3,
        "text": "中火で12分蒸す。軽く混ぜてニラをのせ、さらに3分蒸す。"
      },
      {
        "stepNo": 4,
        "text": "お好みでしょうゆをかける。"
      }
    ]
  },
